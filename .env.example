# Environment configuration for IdemPay / Assessment 2: Payment and Subscription Slice
# Copy this file to .env and fill in your own values. Never commit real keys.

# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/idempay?schema=public"

# System currency (Locked to USD as single system-wide currency)
SYSTEM_CURRENCY=USD

# ---------------------------------------------------------------------------
# Flutterwave Configuration (TEST / SANDBOX MODE)
# ---------------------------------------------------------------------------
# Get your sandbox keys from the Flutterwave Dashboard:
#   https://dashboard.flutterwave.com -> Settings -> API
# Sandbox keys are prefixed FLWPUBK_TEST- / FLWSECK_TEST-.
#
# PUBLIC key - safe for the browser (hosted checkout page).
# SECRET key - server-only. Used for POST /v3/payments and transaction verify.
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-REPLACE_WITH_YOUR_SANDBOX_PUBLIC_KEY"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-REPLACE_WITH_YOUR_SANDBOX_SECRET_KEY"

# Long random string (>= 16 chars) used to verify webhooks via the `verif-hash`
# header. MUST match the "Secret hash" set in the Flutterwave dashboard webhooks tab.
FLUTTERWAVE_SECRET_HASH="REPLACE_WITH_RANDOM_SECRET_HASH"

# Flutterwave API base (v3). Keep as-is for sandbox.
FLUTTERWAVE_API_BASE="https://api.flutterwave.com/v3"

# Public webhook URL reachable from the internet (use ngrok for local dev).
FLUTTERWAVE_WEBHOOK_URL="http://localhost:3000/api/webhooks/flutterwave"

# Payment plan IDs (from POST /v3/payment-plans) to enable auto-recurring billing.
FLUTTERWAVE_PAYMENT_PLAN_MONTHLY=""
FLUTTERWAVE_PAYMENT_PLAN_YEARLY=""

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"