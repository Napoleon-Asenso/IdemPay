# Environment configuration for IdemPay / Assessment 2: Payment and Subscription Slice

# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/idempay?schema=public"

# System currency (Locked to USD)
SYSTEM_CURRENCY=USD

# Flutterwave Configuration
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-mock-public-key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-mock-secret-key"
FLUTTERWAVE_SECRET_HASH="flutterwave-test-secret-hash-12345"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
